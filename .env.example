# Docker Compose development settings. Copy this file to .env before starting services.
# The password below is an example only; replace it in every non-disposable environment.
POSTGRES_DB=smartestimate
POSTGRES_USER=smartestimate
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_PORT=5432

BACKEND_PORT=8080
FRONTEND_PORT=3000

# Swagger is enabled by the Development environment configured here.
ASPNETCORE_ENVIRONMENT=Development
DATABASE_APPLY_MIGRATIONS_ON_STARTUP=true
SERILOG_MINIMUM_LEVEL=Information
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# The browser client uses the nginx same-origin proxy in Compose.
VITE_API_BASE_URL=/api
# Used only by `npm run dev --prefix frontend` outside Docker Compose.
VITE_API_PROXY_TARGET=http://localhost:8080
